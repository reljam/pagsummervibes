  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Old Town Summer Vibes - Whole house for rent in the town of Pag",
        "meta_descr": "This whole house rental on the edge of the old town core is ideally located within walking distance of everything Pag has to offer – beaches, vibrant cafes, delicious restaurants, and captivating historical landmarks.\n\nUnwind in comfort with a fully equipped kitchen (including a dishwasher!), two bathrooms with showers, three Smart TVs, and two air conditioning units for year-round comfort. The private bedrooms feature comfy beds, ensuring a restful stay. After exploring all day, relax and enjoy the fresh air on the charming semi-covered terrace.\n\nFor some extra entertainment, head to the third floor and challenge your friends to a game of foosball or relax with a movie on the Smart TV. There's even a handy retro fridge to keep your drinks chilled.\n\nBook your unforgettable Pag escape today!",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/dsc-161.jpg"
      },
      "components": [
        {
          "alias": false,
